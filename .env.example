# Every value below is optional unless noted. Field names on Settings map to
# these upper-case keys (src/ai_job_tracker/config.py). Leaving a key blank is
# treated as unset, so the documented default applies.

# --- Telegram (required before any notification is sent) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Analysis backend ---
# "api" (default) or "browser". Install the matching extra:
#   pip install 'ai-job-tracker[api]'      # pydantic-ai
#   pip install 'ai-job-tracker[browser]'   # Playwright
ANALYSIS_BACKEND=

# --- API backend (ANALYSIS_BACKEND=api) ---
# API key for the configured model. For Gemini: https://aistudio.google.com/api-keys
AI_API_KEY=
# pydantic-ai model string. Default: google:gemini-2.0-flash
# Examples: google:gemini-2.0-flash, openai:gpt-4o, anthropic:claude-sonnet-4-20250514
AI_MODEL=

# --- Browser backend (ANALYSIS_BACKEND=browser) ---
# After installing the extra, run: playwright install chromium
# Path to a Chrome/Brave profile with an authenticated Gemini session.
BROWSER_PROFILE_PATH=
# Optional browser executable (command name or absolute path). Omit for Playwright's bundled Chromium.
GEMINI_BROWSER_EXECUTABLE=

# --- File paths (relative to the directory the CLI runs in) ---
PROFILE_FILE=
JOBS_INPUT_FILE=
ANALYSIS_OUTPUT_FILE=
